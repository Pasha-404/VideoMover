<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_background"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/btnSettings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/vm_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/main_title"
                android:textColor="@color/vm_text_muted"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/vm_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/vm_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvStorageStatus"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_status_missing"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:text="@string/main_usb_missing"
                        android:textColor="@color/vm_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_usb_24" />

                    <TextView
                        android:id="@+id/tvDestHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/main_info_title"
                        android:textColor="@color/vm_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:text="@string/dest_not_selected"
                        android:textColor="@color/vm_text_muted"
                        android:textSize="13sp"
                        tools:text="Destination: USB Drive, /Movies" />

                    <TextView
                        android:id="@+id/tvSearchMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/vm_text_muted"
                        android:textSize="13sp"
                        tools:text="Search: all camera folders" />

                    <TextView
                        android:id="@+id/tvActionMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/vm_text_muted"
                        android:textSize="13sp"
                        tools:text="Mode: move originals after copy" />

                    <TextView
                        android:id="@+id/tvVideoAccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/main_video_access_denied"
                        android:textColor="@color/vm_warning"
                        android:textSize="13sp"
                        tools:text="Video access: selected videos only" />

                    <TextView
                        android:id="@+id/tvFreeSpace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/vm_text_muted"
                        android:textSize="13sp"
                        tools:text="Free space: 24.5 GB" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProcess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/vm_surface_high"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/vm_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvProcessStage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/process_idle_move_title"
                        android:textColor="@color/vm_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/processProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="10dp"
                        android:indeterminate="false"
                        android:max="1000"
                        android:progress="0"
                        android:progressTint="@color/vm_primary"
                        android:progressBackgroundTint="@color/vm_outline" />

                    <TextView
                        android:id="@+id/tvProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="4"
                        android:minHeight="34dp"
                        android:text="@string/process_idle_detail"
                        android:textColor="@color/vm_text_muted"
                        android:textSize="13sp"
                        tools:text="Copying 3 of 10\nVID_20260510.mp4\n120 MB / 840 MB · 18 MB/s" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEjectHint"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/eject_ready_button"
                        android:textAllCaps="false"
                        android:textColor="@color/vm_success"
                        android:textSize="14sp"
                        android:visibility="gone"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_usb_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/vm_success"
                        app:strokeColor="@color/vm_success"
                        app:strokeWidth="1dp"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTransfer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:enabled="false"
                android:text="@string/transfer"
                android:textAllCaps="false"
                android:textColor="@color/vm_on_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/vm_primary_deep"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_transfer_24"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/vm_on_primary" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginBottom="12dp"
        android:minWidth="168dp"
        android:text="@string/settings"
        android:textAllCaps="false"
        android:textColor="@color/vm_text"
        app:cornerRadius="23dp"
        app:icon="@drawable/ic_settings_24"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/vm_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/vm_outline"
        app:strokeWidth="1dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
